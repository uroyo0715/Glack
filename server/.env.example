# Google Cloud Console > APIとサービス > 認証情報 で発行する
# OAuthクライアントID（種類: ウェブアプリケーション）の値をここに入れる。
# 承認済みのリダイレクトURIには GOOGLE_REDIRECT_URI と同じ値を登録すること。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 上記クライアントの「承認済みのリダイレクトURI」に登録した値と一致させる
GOOGLE_REDIRECT_URI=http://localhost:8787/api/v1/auth/google/callback

# ログイン成功後にリダイレクトするフロントエンドのURL（Viteのdevサーバー）
FRONTEND_URL=http://localhost:5173/

# Unity SDKからの投稿を保護するAPIキー。未設定の間は認証チェックをスキップする（開発用）
GLANK_API_KEY=

# --- コントロールプレーンDB（Turso）---
# users/projects/sessions/projectMembers 等、Glank運営自身のデータを持つ唯一のDB。
# 未設定なら自動でローカルのglank.sqliteファイルを使う（開発時はこのままでよい）。
# https://turso.tech でDBを作成し、`turso db show <db> --url` / `turso db tokens create <db>` で取得する。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- managedプラン用の共有ストレージ（Cloudflare R2）---
# プロジェクトのstorageModeが'managed'の場合に使う、Glankが用意する共有ストレージ。
# 'self_hosted'（既定）のプロジェクトはチームが自分のR2/Turso接続情報を設定画面から入力する
# （projectsテーブルに暗号化して保存。下のGLANK_ENCRYPTION_KEYが必要）。
# 4つとも未設定なら自動でローカルディスク（server/uploads）に保存する（開発時はこのままでよい）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# バケットの「パブリック開発URL」またはカスタムドメイン（末尾に/を付けない）
R2_PUBLIC_URL=

# --- self_hostedプロジェクトの接続情報を暗号化する鍵（AES-256-GCM）---
# 32byteをbase64化した文字列。生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 本番でこれを紛失/変更すると、既に保存済みのself_hosted接続情報が復号できなくなる点に注意。
GLANK_ENCRYPTION_KEY=
